  "description": "",
  "main": "index.js",
  "scripts": {
    "test:day25": "mocha day25/test/**/*.test.js",
    "test:day48": "jest day48/tests/**/*.test.js",
    "test:day54": "node --test day54/test/**/*.test.js",
    "start:day54": "node day54/index.js",
    "dev:day55": "node day55/server.js",
    "prisma:migrate:day55": "prisma migrate dev --name init --schema=./day55/prisma/schema.prisma --config=./day55/prisma/prisma.config.ts",
    "prisma:generate:day55": "prisma generate --schema=./day55/prisma/schema.prisma --config=./day55/prisma/prisma.config.ts",
    "prisma:studio:day55": "prisma studio --schema=./day55/prisma/schema.prisma --config=./day55/prisma/prisma.config.ts",
    "db:seed:day55": "npm run prisma:generate:day55 && node day55/prisma/seed.js",
    "test:day65": "jest day65/tests/*.test.js",
    "day66:prisma:migrate": "prisma migrate dev --name init --schema=./day66/prisma/schema.prisma --config=./day66/prisma/prisma.config.ts",
    "day66:db:seed": "node day66/prisma/seed.js"
  },
